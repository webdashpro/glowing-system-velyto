# --- Database (free Neon / Supabase / any PostgreSQL) -------------------------
# Neon:     postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require
# The app connects lazily at runtime, so `npm run build` works even if this is empty.
DATABASE_URL=

# --- Site / SEO ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://velyto.netlify.app
# Google Search Console HTML-tag verification token (content="..." value only). Optional.
NEXT_PUBLIC_GSC_VERIFICATION=
# Plausible analytics domain, e.g. velyto.netlify.app. Optional — renders nothing when unset.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
